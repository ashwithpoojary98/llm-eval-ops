# ──────────────────────────────────────────────────────────────────────────────
# LLMOps Eval Platform — Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=llmevalplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme           # CHANGE THIS
POSTGRES_PORT=5432

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8080

# JWT — must be a random 256-bit (32-char+) secret
JWT_SECRET_KEY=change-this-to-a-secure-256-bit-secret-key-in-production

# AES encryption key for API keys & secrets stored in DB (exactly 32 chars)
APP_ENCRYPTION_KEY=change-this-to-a-32-char-key-prod

# ── Admin Bootstrap (first-run only) ──────────────────────────────────────────
LLMOPS_ADMIN_EMAIL=admin@example.com
LLMOPS_ADMIN_PASSWORD=ChangeMe123!   # CHANGE THIS
LLMOPS_ORG_NAME=My Organization
LLMOPS_ALLOWED_DOMAINS=example.com
LLMOPS_BASE_URL=http://localhost:3000

# ── Evaluation Engine ──────────────────────────────────────────────────────────
ENGINE_PORT=8000
DEBUG=false

# Shared secret for internal callback auth (backend ↔ eval-engine)
# Generate with: openssl rand -hex 32
EVALUATION_CALLBACK_SECRET=change-this-to-a-random-secret
# Must also be set in eval-engine env:
CALLBACK_SECRET=change-this-to-a-random-secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list — set to your actual frontend domain in production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ────────────────────────────────────────────────────────────────────
# Use INFO in production, DEBUG only for local development
LOG_LEVEL=INFO

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
# For production, set this to your public backend URL:
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ── Email (optional — can also be configured via Admin UI) ─────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=LLMOps Platform
