# LLMOps platform URL (default: local Docker)
LLMOPS_API_URL=http://localhost:8080/api

# Get this from: POST /api/auth/login → .token
LLMOPS_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Optional: your OpenAI key for real answers + LLM-judge metrics
# Leave blank or set to "mock" to use mock answers (free, good for testing eval pipeline)
OPENAI_API_KEY=sk-...

# Optional: paste your project ID to skip auto-lookup
LLMOPS_PROJECT_ID=
